# ===========================================
# Translation Session Server
# ===========================================
# WICHTIG: Diese Datei NIEMALS mit echten Werten committen!
# Kopiere diese Datei zu .env und fülle die Werte aus.

# ===========================================
# Database
# ===========================================
POSTGRES_USER=translation_user
POSTGRES_PASSWORD=         # <- Sicheres Passwort hier
POSTGRES_DB=translation_db
DATABASE_URL=postgresql://translation_user:DEIN_PASSWORT@db:5432/translation_db

# ===========================================
# Backend Security
# ===========================================
SECRET_KEY=                # <- Generiere mit: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# Azure Speech Services
# ===========================================
AZURE_SPEECH_KEY=          # <- Aus Azure Portal
AZURE_SPEECH_REGION=westeurope

# ===========================================
# Azure Translator
# ===========================================
AZURE_TRANSLATOR_KEY=      # <- Aus Azure Portal
AZURE_TRANSLATOR_REGION=westeurope
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# ===========================================
# URLs (anpassen an deine Domain)
# ===========================================
FRONTEND_URL=https://translator.fvtk.de
NEXT_PUBLIC_API_URL=https://translator.fvtk.de
NEXT_PUBLIC_WS_URL=wss://translator.fvtk.de

# ===========================================
# Registration Protection
# ===========================================
INVITE_CODE=                # <- Einladungscode für Registrierung

# ===========================================
# Domain & SSL
# ===========================================
DOMAIN=translator.fvtk.de
EMAIL=maximilian.vuckovic@fv-technische-keramik.de
